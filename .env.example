APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://echoid:echoid@db:5432/echoid
STORAGE_DIR=./uploads
ACCESS_TOKEN_MINUTES=60
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FREE_CREDITS=5
CREDIT_COST_PER_GENERATION=1
MAX_UPLOAD_MB=25

# Optional external transcription service. Leave empty to use the clearly
# marked demo adapter (it does not process audio).
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=

# Safaricom Daraja (M-Pesa). Use sandbox credentials during development.
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=
MPESA_PAYBILL_OR_TILL=
MPESA_PAYMENT_TYPE=paybill

# Stripe card fallback.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=http://localhost:8000/payment/success
PAYMENT_CANCEL_URL=http://localhost:8000/payment/cancel
